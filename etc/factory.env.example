# Settings for the factory. Copied to /etc/factory/factory.env by install.sh.
# ntfy topic that receives alerts and update notes. Generated when left empty.
NTFY_TOPIC=
# The shared user that runs Claude Code, tmux and the account rotation.
FACTORY_USER=factory
# The checkout of this repo on the box; `factory update` pulls it and re-runs install.sh.
FACTORY_REPO=/home/factory/work/factory
# Timezone for the box, for example Europe/Madrid. Left empty, the timezone stays as it is.
FACTORY_TIMEZONE=
