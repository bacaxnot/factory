# The shared user's zsh on the factory: oh-my-zsh with the same theme and plugins the team
# uses on their laptops. The environment is in ~/.zshenv. The installer keeps both files in
# place; put personal one-offs in ~/.zshrc.local, which this file sources when it exists.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source "$ZSH/oh-my-zsh.sh"

# A worktree's folder and branch carry the same task name; the prompt caps both at 24 characters.
PROMPT='%(?:%{$fg_bold[green]%}➜ :%{$fg_bold[red]%}➜ ) %{$fg[cyan]%}%24>…>%c%<<%{$reset_color%} $(git_prompt_info)'
ZSH_THEME_GIT_PROMPT_PREFIX="%{$fg_bold[blue]%}git:(%{$fg[red]%}%24>…>"
ZSH_THEME_GIT_PROMPT_DIRTY="%<<%{$fg[blue]%}) %{$fg[yellow]%}✗"
ZSH_THEME_GIT_PROMPT_CLEAN="%<<%{$fg[blue]%})"

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
